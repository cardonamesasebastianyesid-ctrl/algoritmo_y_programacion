
using System;

class Program
{
    static void Main(string[] args)
    {
        // EJERCICIO 1: Cuadrado hueco de lado 5
        Console.WriteLine("1. Cuadrado hueco:");

        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5; j++)
            {
                if (i == 0 || i == 4 || j == 0 || j == 4)
                {
                    Console.Write("*");
                }
                else
                {
                    Console.Write(" ");
                }
            }
            Console.WriteLine();
        }

        // EJERCICIO 2: Triangulo invertido
        Console.WriteLine("\n2. Triangulo invertido:");

        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 5 - i; j++)
            {
                Console.Write("*");
            }
            Console.WriteLine();
        }

        // EJERCICIO 3: Piramide centrada
        Console.WriteLine("\n3. Piramide centrada:");

        for (int i = 0; i < 5; i++)
        {
            for (int j = 0; j < 4 - i; j++)
            {
                Console.Write(" ");
            }

            for (int k = 0; k < 2 * i + 1; k++)
            {
                Console.Write("*");
            }

            Console.WriteLine();
        }

        Console.ReadKey();
    }
}
